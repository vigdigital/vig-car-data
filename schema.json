{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VIG Car Data — brand file",
  "type": "object",
  "required": ["brand", "updated_at", "models"],
  "properties": {
    "brand":      { "type": "string" },
    "brand_name": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" },
    "count":      { "type": "integer" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "source_url", "price", "versions", "specs"],
        "properties": {
          "slug":       { "type": "string" },
          "name":       { "type": "string" },
          "year":       { "type": ["integer", "null"] },
          "source":     { "type": "string", "description": "id nguồn: honda | vnexpress | ..." },
          "source_url": { "type": "string", "format": "uri" },
          "price":      { "type": "integer", "description": "giá thấp nhất (đồng)" },
          "versions":   { "type": "array", "items": { "type": "object", "required": ["name","price"], "properties": { "name": {"type":"string"}, "price": {"type":"integer"} } } },
          "specs":      { "type": "array", "items": { "type": "object", "required": ["label","value"], "properties": { "label": {"type":"string"}, "value": {"type":"string"} } } },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
